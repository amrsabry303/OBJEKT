{{ 'home.css' | asset_url | stylesheet_tag }}
<section class="sec wrap" id="categories" aria-labelledby="cat-h">
  <div class="sec__head"><h2 class="label" id="cat-h">{{ section.settings.heading }}</h2></div>
  <div class="cats">
    <ul>
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          <li {{ block.shopify_attributes }}><a href="{{ c.url }}" data-pane-target="{{ forloop.index }}"><span class="h3">{{ block.settings.title | default: c.title }}</span><span class="cat__end">{%- if block.settings.shape != blank -%}{% render 'shape', name: block.settings.shape %}{%- endif -%}<span class="label" aria-hidden="true">→</span></span></a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="cats__pane" aria-hidden="true">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          <div class="ph{% if forloop.first %} on{% endif %}" data-pane="{{ forloop.index }}">
            {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '40vw', alt: '' }}
            {%- elsif c.image -%}{{ c.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '40vw', alt: '' }}
            {%- else -%}{%- assign pane_shape = block.settings.shape | default: 'vase' -%}{% render 'shape', name: pane_shape %}<span class="tag">{{ 'home.image_to_come' | t }}</span>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<script src="{{ 'home.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Shop by category",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" }],
  "blocks": [
    {
      "type": "category", "name": "Category", "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the collection image." },
        { "type": "select", "id": "shape", "label": "Icon", "info": "Silhouette from the brand guidelines, shown beside the title.", "default": "", "options": [
        { "value": "", "label": "None" },
        { "value": "vase", "label": "Vase" },
        { "value": "vase-faceted", "label": "Faceted vase" },
        { "value": "jug", "label": "Jug" },
        { "value": "bowl", "label": "Bowl" },
        { "value": "table", "label": "Table" },
        { "value": "hourglass", "label": "Hourglass table" },
        { "value": "stool", "label": "Stool" },
        { "value": "pedestal", "label": "Pedestal" },
        { "value": "lamp", "label": "Lamp" },
        { "value": "candle", "label": "Candlestick" },
        { "value": "planter", "label": "Planter" },
        { "value": "cup", "label": "Cup bowl" }
        ] }
      ]
    }
  ],
  "presets": [{ "name": "Shop by category", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
