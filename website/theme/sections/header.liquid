{{ 'header-zara.css' | asset_url | stylesheet_tag }}
{%- assign menu = linklists[section.settings.menu] -%}
{%- assign shop_links = linklists['footer-shop'] -%}
<header class="hdr">
  <div class="hdr__in wrap">
    <div class="hdr__lead">
      <button class="menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="{{ 'general.menu' | t }}"><span class="burger" aria-hidden="true"><i></i><i></i><i></i></span></button>
      <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} {{ 'general.home' | t }}"><img src="{{ 'objekt-wordmark.svg' | asset_url }}" alt="" width="100" height="22"></a>
    </div>
    <form class="hdr__search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <label class="sr" for="hdr-q">{{ 'general.search' | t }}</label>
      <input id="hdr-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}" autocomplete="off">
      <button type="submit" aria-label="{{ 'general.search' | t }}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg></button>
    </form>
    <div class="hdr__tools">
      <a class="label tool-desktop" href="/pages/custom-request"{% if page.handle == 'custom-request' %} aria-current="page"{% endif %}>Customize</a>
      <a class="label" href="{{ routes.cart_url }}">{{ 'general.bag' | t }} (<span data-bag>{{ cart.item_count }}</span>)</a>
    </div>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="{{ 'general.menu' | t }}">
  <nav class="menu__body" aria-label="{{ 'general.primary_nav' | t }}">
    <ul class="menu__group">
      <li><a href="{{ routes.all_products_collection_url }}">{{ 'general.view_all' | t }}</a></li>
      {%- for link in shop_links.links -%}
        <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
    <ul class="menu__group">
      {%- for link in menu.links -%}
        {%- if link.type == 'catalog_link' -%}{%- continue -%}{%- endif -%}
        {%- if link.links.size > 0 -%}
          <li><details><summary>{{ link.title }}</summary><ul>{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}</ul></details></li>
        {%- else -%}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <ul class="menu__group sm">
      <li><a href="{{ routes.cart_url }}">{{ 'general.bag' | t }} (<span data-bag>{{ cart.item_count }}</span>)</a></li>
    </ul>
  </nav>
</dialog>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Header",
  "settings": [{ "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }]
}
{% endschema %}
