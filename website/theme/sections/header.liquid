{%- assign menu = linklists[section.settings.menu] -%}
<header class="hdr">
  <div class="hdr__in wrap">
    <button class="menu-btn label" type="button" data-menu-open aria-expanded="false" aria-controls="menu">{{ 'general.menu' | t }}</button>
    <nav aria-label="{{ 'general.primary_nav' | t }}">
      <ul>
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <li class="has-panel">
              <a class="label" href="{{ link.url }}"{% if link.child_current or link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
              <div class="panel">
                <div class="panel__in wrap">
                  <p class="label muted">{{ link.title }}</p>
                  <ul>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </li>
          {%- else -%}
            <li><a class="label" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} {{ 'general.home' | t }}"><img src="{{ 'objekt-wordmark.svg' | asset_url }}" alt="" width="100" height="22"></a>
    <div class="hdr__tools">
      <a class="label tool-desktop" href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
      {%- if shop.customer_accounts_enabled -%}<a class="label tool-desktop" href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>{%- endif -%}
      <a class="label" href="{{ routes.cart_url }}">{{ 'general.bag' | t }} (<span data-bag>{{ cart.item_count }}</span>)</a>
    </div>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="{{ 'general.menu' | t }}">
  <div class="menu__top wrap">
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} {{ 'general.home' | t }}"><img src="{{ 'objekt-wordmark.svg' | asset_url }}" alt="" width="100" height="22"></a>
    <button class="label" type="button" data-menu-close>{{ 'general.close' | t }}</button>
  </div>
  <div class="menu__body">
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <details>
          <summary>{{ link.title }}</summary>
          <ul>
            <li><a href="{{ link.url }}">{{ 'general.view_all' | t }}</a></li>
            {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
          </ul>
        </details>
      {%- else -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="menu__foot label">
    <a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
    {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>{%- endif -%}
    <a href="{{ routes.cart_url }}">{{ 'general.bag' | t }} (<span data-bag>{{ cart.item_count }}</span>)</a>
  </div>
</dialog>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Header",
  "settings": [{ "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }]
}
{% endschema %}
