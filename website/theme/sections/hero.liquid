{{ 'home.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Image: the picker wins. With no image chosen the hero borrows a product photograph (the first landscape image in the shop, else the first product image), so the page never opens on an empty frame.
{%- endcomment -%}
{%- assign hero_media = blank -%}
{%- unless section.settings.image -%}
  {%- for p in collections.all.products limit: 24 -%}
    {%- for m in p.media -%}
      {%- if m.media_type == 'image' and m.aspect_ratio >= 1.3 -%}{%- assign hero_media = m -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if hero_media != blank -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if hero_media == blank -%}{%- assign hero_media = collections.all.products.first.featured_media -%}{%- endif -%}
{%- endunless -%}
{%- assign tone = section.settings.tone -%}
{%- if tone == 'auto' -%}{%- if section.settings.image or hero_media != blank -%}{%- assign tone = 'light' -%}{%- else -%}{%- assign tone = 'dark' -%}{%- endif -%}{%- endif -%}
<section class="hero hero--{{ tone }}" aria-labelledby="hero-h">
  <div class="hero__img{% unless section.settings.image or hero_media != blank %} ph{% endunless %}">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt, class: 'hero__photo' }}
    {%- elsif hero_media != blank -%}
      {{ hero_media | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: '', class: 'hero__photo' }}
    {%- else -%}
      {% render 'shape', name: 'table' %}
    {%- endif -%}
  </div>
  <div class="hero__copy">
    {%- if section.settings.label != blank -%}<span class="label">{{ section.settings.label }}</span>{%- endif -%}
    <h1 class="h1" id="hero-h">{{ section.settings.heading | escape | newline_to_br }}</h1>
    {%- if section.settings.link_label != blank -%}<a class="link" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave room for the text at the bottom of the image, in both English and Arabic." },
    { "type": "select", "id": "tone", "label": "Text colour", "default": "auto", "options": [{ "value": "auto", "label": "Automatic (light on a photograph)" }, { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }] },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Objekts\nof Character." },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Explore the Collection" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
