{{ 'home.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'editorial.css' | asset_url | stylesheet_tag }}
<header class="ahead wrap">
  <nav class="crumbs label" aria-label="{{ 'collection.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home_crumb' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ 'collection.list_title' | t }}</span></nav>
  <h1 class="atitle">{{ 'collection.list_title' | t }}</h1>
</header>
<section class="sec wrap">
  <div class="cats" style="grid-template-columns: 1fr">
    <ul>
      {%- for c in collections -%}
        {%- if c.handle != 'frontpage' and c.handle != 'all' and c.products_count > 0 -%}
          <li><a href="{{ c.url }}"><span class="h3">{{ c.title }}</span><span class="label" aria-hidden="true">→</span></a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
