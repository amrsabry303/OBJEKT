{{ 'collection.css' | asset_url | stylesheet_tag }}
<style>
  .pw { min-height: 100svh; display: grid; align-content: center; justify-items: start; gap: 28px; padding: var(--margin); max-width: 560px; margin-inline: auto; color: var(--navy); }
  .pw img { height: 28px; width: auto; }
  .pw form { display: flex; border-block-end: 1px solid var(--navy); width: 100%; }
  .pw input { flex: 1; background: none; border: 0; padding: 12px 0; font: inherit; color: var(--ink); min-width: 0; }
  .pw button { min-height: 44px; min-width: 44px; padding-inline: 8px; }
  .pw__msg { margin: 0; max-width: 40ch; color: var(--ink); }
</style>
<div class="pw">
  <img src="{{ 'objekt-wordmark.svg' | asset_url }}" alt="{{ shop.name }}" width="140" height="31">
  {%- if section.settings.message != blank -%}<p class="pw__msg">{{ section.settings.message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    <label class="sr" for="pw-input">{{ 'password.label' | t }}</label>
    <input id="pw-input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" dir="ltr" required>
    <button class="label" type="submit">{{ 'password.submit' | t }}</button>
    {%- if form.errors -%}<p role="alert">{{ 'password.error' | t }}</p>{%- endif -%}
  {%- endform -%}
  <a class="link" href="/admin">{{ 'password.owner' | t }}</a>
</div>
{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "textarea", "id": "message", "label": "Message", "info": "Shown above the password box. Leave empty for none." }]
}
{% endschema %}
