{{ 'home.css' | asset_url | stylesheet_tag }}
{%- assign b = section.settings.blog -%}
{%- if b != blank and b.articles_count > 0 -%}
<section class="sec wrap" id="edit" aria-labelledby="edit-h">
  <div class="sec__head"><h2 class="label" id="edit-h">{{ section.settings.heading }}</h2><a class="link" href="{{ b.url }}">{{ 'home.all_stories' | t }}</a></div>
  <div class="grid edit">
    {%- for article in b.articles limit: 3 -%}
      <article class="story-card s{{ forloop.index }}">
        <a href="{{ article.url }}">
          <div class="ph">
            {%- if article.image -%}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(max-width: 760px) 100vw, 50vw', alt: article.image.alt | default: '' }}{%- else -%}<span class="tag">{{ 'home.image_to_come' | t }}</span>{%- endif -%}
          </div>
          <div class="meta label muted">{% if article.tags.size > 0 %}<span>{{ article.tags.first }}</span>{% endif %}<span>{{ article.published_at | time_tag: format: 'abbreviated_date' }}</span></div>
          <h3 class="h3">{{ article.title }}</h3>
        </a>
      </article>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "The Edit",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Edit" },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "presets": [{ "name": "The Edit" }]
}
{% endschema %}
