{%- comment -%} Accepts: product. A plate: image, title, availability, price. Hover swap only where hover exists (D-020). {%- endcomment -%}
<article class="obj">
  <a href="{{ product.url }}">
    <div class="ph{% unless product.featured_media %} ph--empty{% endunless %}">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(max-width: 760px) 50vw, (max-width: 1100px) 33vw, 25vw', alt: product.featured_media.alt | default: product.title }}
        {%- if product.media.size > 1 -%}
          {{ product.media[1] | image_url: width: 800 | image_tag: loading: 'lazy', class: 'alt', alt: '', widths: '400, 600, 800', sizes: '(max-width: 760px) 50vw, (max-width: 1100px) 33vw, 25vw' }}
        {%- endif -%}
      {%- else -%}
        {%- assign shape_i = product.id | modulo: 12 -%}{% render 'shape', index: shape_i %}
        <span class="tag">{{ 'collection.no_image' | t }}</span>
      {%- endif -%}
    </div>
    <div class="cap">
      <div>
        <div class="name">{{ product.title }}</div>
        {% render 'availability', product: product %}
      </div>
      <div class="price">{% if product.price_varies %}{{ 'collection.from' | t }} {% endif %}<bdi>{{ product.price | money_without_trailing_zeros }}</bdi></div>
    </div>
  </a>
</article>
